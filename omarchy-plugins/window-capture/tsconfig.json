{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "app.tsx",
    "accessibility.ts",
    "bind.ts",
    "contract.ts",
    "hyprland.ts",
    "signal.ts",
    "test"
  ]
}
